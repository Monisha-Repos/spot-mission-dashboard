# Copy to backend/.env (git-ignored). Real environment variables override this file.
# Databricks settings are read from ../ingest-api/.env automatically; repeat them here only to override.

# Where to read mission data: databricks, local (data/lakehouse, written by the ingest API) or kit (raw data/kit).
# Default: databricks if DATABRICKS_HOST is set, else local if data/lakehouse exists, else kit.
LAKEHOUSE=

# Operator Console
OPS_ENABLED=true
# Shared sign-in PIN for operators and supervisors. Sign-in is disabled until this is set.
OPS_PIN=
# Random string that signs sign-in tokens. Without it, everyone is signed out when the server restarts.
OPS_SECRET=
# Same value as the ingest API's INGEST_API_KEY, so only it can send /ops/ingest-hook notifications.
INGEST_API_KEY=
# Where the Java ingest API runs; the Operator Console's live-feed controls are forwarded there.
INGEST_URL=http://localhost:8081

# AI assistant: anthropic, huggingface or none (answers with the matching records only).
# Default: anthropic if ANTHROPIC_API_KEY is set, else huggingface if HF_TOKEN is set, else none.
ASK_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high: low keeps chat answers fast
ASK_EFFORT=low
HF_TOKEN=
HF_CHAT_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# Pinned inference provider for the main model ("auto" lets Hugging Face choose); the fallback uses auto routing.
HF_PROVIDER=deepinfra
HF_FALLBACK_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Spend guard: stop paid answers once this month's estimated spend reaches the budget (USD); per-browser limits.
ASK_BUDGET_USD=5
ASK_PER_MINUTE=6
ASK_PER_HOUR=40

# Published Hugging Face repos, linked from the Data Analysis tab (see ml/build_dataset.py and ml/push_to_hub.py).
HF_DATASET_REPO=
HF_MODEL_REPO=

# Comma-separated origins allowed to call the API from a browser (* = any)
CORS_ORIGINS=*
