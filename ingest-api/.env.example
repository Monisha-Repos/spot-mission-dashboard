# Copy to .env (git-ignored). Real environment variables override this file.

# local = CSV files in LAKEHOUSE_DIR (offline demo); databricks = Delta tables.
# Defaults to databricks when DATABRICKS_HOST is set.
SINK=local
LAKEHOUSE_DIR=../data/lakehouse
KIT_DATA_DIR=../data/kit

# Workspace URL, e.g. https://dbc-xxxx.cloud.databricks.com
DATABRICKS_HOST=
# SQL Warehouses -> your warehouse -> Connection details -> HTTP path (/sql/1.0/warehouses/<id>)
DATABRICKS_HTTP_PATH=
# Profile -> Settings -> Developer -> Access tokens. Never commit or share this.
DATABRICKS_TOKEN=
# Free Edition's catalog is "workspace"; the schema is created by `seed`.
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=spot

PORT=8081
# When set, POST /ingest/missions requires the header X-API-Key with this value.
INGEST_API_KEY=
# Optional: the Python backend endpoint that refreshes its cache and opens Operator Console issues.
INGEST_WEBHOOK_URL=
